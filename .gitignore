# ==========================
# 1. 시스템 및 에디터 설정 (OS & IDE)
# ==========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ==========================
# 2. 보안 파일 (★가장 중요★)
# ==========================
# API 키, DB 비밀번호 등이 들어있는 파일은 절대 올리면 안 됩니다.
.env
.env.*
.secrets
secrets.json

# ==========================
# 3. Python (Backend) 관련
# ==========================
# 컴파일된 파이썬 캐시 파일
__pycache__/
*.py[cod]
*$py.class

# 가상환경 (Virtual Environment)
venv/
.venv/
env/
my_env/

# 로그 파일
*.log

# ==========================
# 4. Node.js (Frontend) 관련
# ==========================
# 의존성 라이브러리 폴더 (용량이 매우 큼)
node_modules/

# 빌드 결과물
build/
dist/
.next/

# 패키지 로그 (에러 발생 시 생성되는 로그)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================
# 5. AI/ML 모델 및 데이터 파일 (이미지 참고)
# ==========================
# YOLO 등 딥러닝 모델 가중치 파일 (.pt 파일은 용량이 커서 보통 깃허브에 안 올립니다)
*.pt
*.pth
*.onnx
yolov8n.pt
best.pt
last.pt

# 데이터셋이나 테스트용 이미지
*.jpg
*.jpeg
*.png
!logo.png  # (예외) 로고 같은 건 올려야 한다면 앞에 !를 붙이세요

# ==========================
# 6. 프로젝트 특정 폴더 (이미지 참고)
# ==========================
# 임시 폴더 무시
temp/
backend/py_model/temp/

# static 폴더 안의 업로드된 파일들 (필요시 주석 해제)
# 사용자가 업로드한 이미지는 깃에 관리하지 않는 게 좋습니다.
# backend/py_model/static/uploads/